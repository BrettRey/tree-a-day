#!/usr/bin/env bash
# Render two .cgel trees side by side, bottom-aligned, as one PNG.
# Usage: bin/pair left.cgel right.cgel out-stem   (writes out-stem.png beside out-stem)
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
py="$here/.venv/bin/python"
abs() { echo "$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"; }
left="$(abs "$1")"; right="$(abs "$2")"; out="$(abs "$3")"
dir="$(dirname "$out")"; stem="$(basename "$out")"

for f in "$left" "$right"; do (cd "$here/vendor/cgel" && "$py" validate_trees.py "$f") || true; done

(cd "$here/vendor/cgel" && "$py" - "$left" "$right") > "$dir/$stem.tex" <<'EOF'
import sys
from itertools import chain
import cgel, tree2tex
trees = [next(cgel.trees(chain(open(fp)))) for fp in sys.argv[1:3]]
# standalone without the tikz option keeps both pictures on one page
header = tree2tex.HEADER.replace(r'\documentclass[tikz,border=12pt]{standalone}',
                                 r'\documentclass[border=12pt]{standalone}')
# baseline on the leaves sets each picture's baseline at its leaf row, so trees of
# different depths still line up their leaves
draw = lambda t: t.drawtex().replace('tier=word,', 'tier=word, baseline,', 1)
print(header + draw(trees[0]) + r'\hspace{3em}' + draw(trees[1]) + tree2tex.FOOTER)
EOF
(cd "$dir" && pdflatex -interaction=nonstopmode -halt-on-error "$stem.tex" > "$stem.build.log" 2>&1) \
  || { grep -m5 '^!' "$dir/$stem.build.log"; exit 1; }
pdftocairo -png -r 300 -singlefile "$dir/$stem.pdf" "$dir/$stem"
rm -f "$dir/$stem.aux" "$dir/$stem.log"
echo "wrote $dir/$stem.png"
